diff --git a/tests/unit/space-theme-store.test.js b/tests/unit/space-theme-store.test.js
new file mode 100644
index 0000000..e064254
--- /dev/null
+++ b/tests/unit/space-theme-store.test.js
@@ -0,0 +1,65 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+
+function installChrome() {
+    const data = {};
+    const listeners = [];
+    globalThis.chrome = {
+        storage: {
+            sync: {
+                get: async key => (key in data ? { [key]: structuredClone(data[key]) } : {}),
+                set: async obj => {
+                    const changes = {};
+                    for (const [k, v] of Object.entries(obj)) {
+                        changes[k] = { oldValue: data[k], newValue: structuredClone(v) };
+                        data[k] = structuredClone(v);
+                    }
+                    listeners.forEach(l => l(changes, 'sync'));
+                }
+            },
+            onChanged: { addListener: l => listeners.push(l), removeListener: l => listeners.splice(listeners.indexOf(l), 1) }
+        }
+    };
+    return data;
+}
+
+const store = await import('../../space-theme-store.js');
+
+test('themes are saved per space name in chrome.storage.sync', async () => {
+    const data = installChrome();
+    await store.saveSpaceTheme('Work', { colors: ['#1b1d3a'], mode: 'dark', intensity: 1, grain: 0.2 });
+    assert.deepEqual(data.spaceThemes, { Work: { colors: ['#1b1d3a'], mode: 'dark', intensity: 1, grain: 0.2 } });
+    assert.deepEqual(Object.keys(await store.loadSpaceThemes()), ['Work']);
+});
+
+test('saving null removes the theme; invalid themes are not stored', async () => {
+    const data = installChrome();
+    await store.saveSpaceTheme('Home', { colors: ['#fbf8e8'] });
+    await store.saveSpaceTheme('Home', null);
+    await store.saveSpaceTheme('bad', { colors: [] });
+    assert.deepEqual(data.spaceThemes, {});
+});
+
+test('rapid edits are serialized and none are lost', async () => {
+    const data = installChrome();
+    await Promise.all(['a', 'b', 'c', 'd'].map(n => store.saveSpaceTheme(n, { colors: ['#000000'] })));
+    assert.deepEqual(Object.keys(data.spaceThemes).sort(), ['a', 'b', 'c', 'd']);
+});
+
+test('renaming a space keeps its theme', async () => {
+    const data = installChrome();
+    await store.saveSpaceTheme('Projects', { colors: ['#3ddc97'] });
+    await store.renameSpaceTheme('Projects', 'Work');
+    assert.deepEqual(Object.keys(data.spaceThemes), ['Work']);
+});
+
+test('change listener receives cleaned themes from sync', async () => {
+    installChrome();
+    const seen = [];
+    const off = store.onSpaceThemesChanged(map => seen.push(map));
+    await store.saveSpaceTheme('Reading', { colors: ['#000000'], grain: 0.5 });
+    off();
+    await store.saveSpaceTheme('Other', { colors: ['#000000'] });
+    assert.equal(seen.length, 1);
+    assert.equal(seen[0].Reading.grain, 0.5);
+});
diff --git a/tests/unit/space-theme.test.js b/tests/unit/space-theme.test.js
new file mode 100644
index 0000000..9919365
--- /dev/null
+++ b/tests/unit/space-theme.test.js
@@ -0,0 +1,67 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {
+    normalizeTheme, computeThemeStyle, nearestNamedColor, mixHex, pickTextMode,
+    relativeLuminance, MAX_THEME_COLORS, DEFAULT_THEME
+} from '../../space-theme.js';
+
+test('normalizeTheme keeps valid fields, fixes the rest, rejects themes without colors', () => {
+    assert.deepEqual(normalizeTheme({ colors: ['#ABCDEF', '#123'], mode: 'dark', intensity: 2, grain: -1 }),
+        { colors: ['#abcdef', '#112233'], mode: 'dark', intensity: 1, grain: 0 });
+    assert.equal(normalizeTheme({ colors: ['nope'] }), null);
+    assert.equal(normalizeTheme(null), null);
+    const t = normalizeTheme({ colors: ['#111111', '#222222', '#333333', '#444444'], mode: 'weird' });
+    assert.equal(t.colors.length, MAX_THEME_COLORS);
+    assert.equal(t.mode, DEFAULT_THEME.mode);
+    assert.equal(t.intensity, DEFAULT_THEME.intensity);
+});
+
+test('full intensity paints the exact color', () => {
+    const s = computeThemeStyle({ colors: ['#1b1d3a'], mode: 'auto', intensity: 1, grain: 0 }, false);
+    assert.equal(s.backgroundColor, '#1b1d3a');
+    assert.equal(s.spaceBg, '#1b1d3a');
+    assert.equal(s.text, 'light'); // dark purple needs light text
+});
+
+test('intensity blends toward the light or dark base', () => {
+    const light = computeThemeStyle({ colors: ['#ff0000'], mode: 'light', intensity: 0.5, grain: 0 });
+    const dark = computeThemeStyle({ colors: ['#ff0000'], mode: 'dark', intensity: 0.5, grain: 0 });
+    assert.ok(relativeLuminance(light.backgroundColor) > relativeLuminance(dark.backgroundColor));
+    assert.equal(light.text, 'dark');
+    assert.equal(dark.text, 'light');
+    assert.equal(mixHex('#ff0000', '#000000', 0), '#000000');
+});
+
+test('auto mode follows the system base and picks readable text', () => {
+    const t = { colors: ['#929bbb'], mode: 'auto', intensity: 0.3, grain: 0 };
+    assert.equal(computeThemeStyle(t, false).text, 'dark');
+    assert.equal(computeThemeStyle(t, true).text, 'light');
+    assert.equal(pickTextMode(['#fbf8e8']), 'dark');
+    assert.equal(pickTextMode(['#000000']), 'light');
+    // a gradient from pale to mid-dark is judged on its worst stop
+    assert.equal(pickTextMode(['#fbf8e8', '#5b5b66']), 'dark');
+    assert.equal(pickTextMode(['#1b1d3a', '#929bbb']), 'light');
+});
+
+test('gradients and grain make tab/folder backgrounds see-through', () => {
+    const g = computeThemeStyle({ colors: ['#3ddc97', '#1b1d3a'], mode: 'auto', intensity: 1, grain: 0 });
+    assert.equal(g.backgroundImage, 'linear-gradient(165deg, #3ddc97, #1b1d3a)');
+    assert.equal(g.backgroundSize, '100% 100%');
+    assert.equal(g.spaceBg, 'transparent');
+    const n = computeThemeStyle({ colors: ['#3ddc97'], mode: 'auto', intensity: 1, grain: 0.5 });
+    assert.match(n.backgroundImage, /^url\("data:image\/svg\+xml,.*"\), linear-gradient/);
+    assert.equal(n.backgroundSize, '160px 160px, 100% 100%');
+    assert.equal(n.backgroundRepeat, 'repeat, no-repeat');
+    assert.equal(n.spaceBg, 'transparent');
+});
+
+test('nearestNamedColor maps by hue for tab-group sync', () => {
+    assert.equal(nearestNamedColor('#000000'), 'grey');
+    assert.equal(nearestNamedColor('#fbf8e8'), 'yellow');
+    assert.equal(nearestNamedColor('#3ddc97'), 'green');
+    assert.equal(nearestNamedColor('#1b1d3a'), 'blue');
+    assert.equal(nearestNamedColor('#e9bccb'), 'pink');
+    assert.equal(nearestNamedColor('#a020f0'), 'purple');
+    assert.equal(nearestNamedColor('#ff2222'), 'red');
+    assert.equal(nearestNamedColor('bad'), 'grey');
+});
