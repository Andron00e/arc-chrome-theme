index 0000000..a833489
--- /dev/null
+++ b/space-appearance.js
@@ -0,0 +1,263 @@
+/**
+ * Paints the sidebar with a space's custom theme and provides the theme editor.
+ *
+ * Spaces without a custom theme keep Arcify's named-color behaviour untouched: callers set the
+ * named color first and then call applySpaceTheme(), which only adds the custom paint on top.
+ */
+import {
+    computeThemeStyle, normalizeTheme, nearestNamedColor, DEFAULT_THEME,
+    THEME_PRESETS, MAX_THEME_COLORS, NAMED_COLORS
+} from './space-theme.js';
+import { loadSpaceThemes, saveSpaceTheme, renameSpaceTheme, onSpaceThemesChanged } from './space-theme-store.js';
+import { Logger } from './logger.js';
+
+let themes = {};
+let repaintActiveSpace = () => { };
+const darkQuery = typeof matchMedia === 'function' ? matchMedia('(prefers-color-scheme: dark)') : null;
+
+function systemDark() {
+    return !!darkQuery?.matches;
+}
+
+/**
+ * Load saved themes and keep them current.
+ * @param {() => void} repaint - re-applies the active space's colors (named color + theme)
+ */
+export async function initSpaceThemes(repaint) {
+    repaintActiveSpace = repaint;
+    try {
+        themes = await loadSpaceThemes();
+    } catch (error) {
+        Logger.error('[SpaceTheme] Could not load themes:', error);
+        themes = {};
+    }
+    onSpaceThemesChanged(updated => {
+        themes = updated;
+        repaintActiveSpace();
+    });
+    darkQuery?.addEventListener?.('change', () => repaintActiveSpace());
+}
+
+export function getSpaceTheme(spaceName) {
+    return themes[spaceName] || null;
+}
+
+export function forgetSpaceTheme(spaceName) {
+    if (!(spaceName in themes)) return Promise.resolve();
+    delete themes[spaceName];
+    return saveSpaceTheme(spaceName, null).catch(error => Logger.error('[SpaceTheme] Could not remove theme:', error));
+}
+
+export function handleSpaceRenamed(oldName, newName) {
+    if (oldName === newName || !(oldName in themes)) return Promise.resolve();
+    themes[newName] = themes[oldName];
+    delete themes[oldName];
+    return renameSpaceTheme(oldName, newName).catch(error => Logger.error('[SpaceTheme] Could not rename theme:', error));
+}
+
+const CUSTOM_PROPS = ['--custom-space-bg-color', '--custom-space-bg-image', '--custom-space-bg-size', '--custom-space-bg-repeat'];
+
+function clearCustomPaint(container) {
+    container.classList.remove('custom-space-theme');
+    CUSTOM_PROPS.forEach(p => container.style.removeProperty(p));
+    document.body.classList.remove('space-text-light', 'space-text-dark');
+}
+
+/**
+ * Apply the space's custom theme (or a draft while editing) on top of the named color.
+ * @param {object} space
+ * @param {object|null} [draft] - theme to preview instead of the saved one; null = no custom theme
+ */
+export function applySpaceTheme(space, draft) {
+    const container = document.getElementById('sidebar-container');
+    if (!container || !space) return;
+    const editing = openEditor && openEditor.spaceId === space.id ? openEditor.draft : undefined;
+    const theme = draft !== undefined ? draft : editing !== undefined ? editing : themes[space.name];
+    if (!theme) {
+        clearCustomPaint(container);
+        return;
+    }
+    const style = computeThemeStyle(theme, systemDark());
+    container.classList.add('custom-space-theme');
+    container.style.setProperty('--custom-space-bg-color', style.backgroundColor);
+    container.style.setProperty('--custom-space-bg-image', style.backgroundImage);
+    container.style.setProperty('--custom-space-bg-size', style.backgroundSize);
+    container.style.setProperty('--custom-space-bg-repeat', style.backgroundRepeat);
+    container.style.setProperty('--space-bg-color', style.spaceBg);
+    container.style.setProperty('--space-bg-color-dark', style.spaceBgDark);
+    document.body.classList.toggle('space-text-light', style.text === 'light');
+    document.body.classList.toggle('space-text-dark', style.text === 'dark');
+}
+
+/* ---------------------------------------------------------------- editor */
+
+let openEditor = null;
+
+function el(tag, attrs = {}, children = []) {
+    const node = document.createElement(tag);
+    for (const [k, v] of Object.entries(attrs)) {
+        if (k === 'class') node.className = v;
+        else if (k === 'text') node.textContent = v;
+        else if (k.startsWith('on')) node.addEventListener(k.slice(2), v);
+        else node.setAttribute(k, v);
+    }
+    for (const c of children) node.append(c);
+    return node;
+}
+
+/**
+ * Open the theme editor for a space.
+ * @param {object} space
+ * @param {(namedColor: string) => Promise<void>|void} onNamedColor - keep space.color (tab groups,
+ *        switcher) close to the custom color; the caller persists it.
+ */
+export function openSpaceThemeEditor(space, onNamedColor) {
+    if (openEditor) openEditor.close(true);
+
+    const saved = getSpaceTheme(space.name);
+    const startColor = NAMED_COLORS[space.color] || DEFAULT_THEME.colors[0];
+    const draft = normalizeTheme(saved) || { ...DEFAULT_THEME, colors: [startColor] };
+    let selected = 0;
+    let saveTimer = null;
+    let dirty = false;
+
+    const preview = () => applySpaceTheme(space, draft);
+
+    const persist = async () => {
+        clearTimeout(saveTimer);
+        saveTimer = null;
+        if (!dirty) return;
+        dirty = false;
+        const normalized = normalizeTheme(draft);
+        themes[space.name] = normalized;
+        try {
+            await saveSpaceTheme(space.name, normalized);
+            const named = nearestNamedColor(normalized.colors[0]);
+            if (named !== space.color) await onNamedColor?.(named);
+        } catch (error) {
+            Logger.error('[SpaceTheme] Could not save theme:', error);
+        }
+    };
+    // chrome.storage.sync limits writes per minute, so slider drags only preview; saves are debounced
+    const scheduleSave = () => {
+        dirty = true;
+        clearTimeout(saveTimer);
+        saveTimer = setTimeout(persist, 500);
+    };
+    const changed = (save = true) => {
+        preview();
+        render();
+        if (save) scheduleSave();
+    };
+
+    const modeRow = el('div', { class: 'stheme-modes', role: 'radiogroup', 'aria-label': 'Appearance' });
+    const slotRow = el('div', { class: 'stheme-slots' });
+    const presetRow = el('div', { class: 'stheme-presets' });
+    const intensity = el('input', { type: 'range', min: '0', max: '100', class: 'stheme-range', 'aria-label': 'Intensity' });
+    const grain = el('input', { type: 'range', min: '0', max: '100', class: 'stheme-range', 'aria-label': 'Grain' });
+
+    [['auto', '✦', 'Auto'], ['light', '☀', 'Light'], ['dark', '☾', 'Dark']].forEach(([mode, icon, label]) => {
+        modeRow.append(el('button', {
+            type: 'button', class: 'stheme-mode', 'data-mode': mode, role: 'radio', title: label,
+            onclick: () => { draft.mode = mode; changed(); }
+        }, [el('span', { class: 'stheme-mode-icon', text: icon }), el('span', { text: label })]));
+    });
+
+    THEME_PRESETS.forEach(hex => {
+        presetRow.append(el('button', {
+            type: 'button', class: 'stheme-preset', title: hex, style: `background:${hex}`,
+            onclick: () => { draft.colors[selected] = hex; changed(); }
+        }));
+    });
+
+    intensity.addEventListener('input', () => { draft.intensity = intensity.value / 100; changed(false); });
+    intensity.addEventListener('change', scheduleSave);
+    grain.addEventListener('input', () => { draft.grain = grain.value / 100; changed(false); });
+    grain.addEventListener('change', scheduleSave);
+
+    function markSelected() {
+        slotRow.querySelectorAll('.stheme-slot').forEach((slot, i) => slot.classList.toggle('selected', i === selected));
+        presetRow.querySelectorAll('.stheme-preset').forEach(b => b.classList.toggle('selected', b.title === draft.colors[selected]));
+    }
+
+    function render() {
+        modeRow.querySelectorAll('.stheme-mode').forEach(b => {
+            const on = b.dataset.mode === draft.mode;
+            b.classList.toggle('selected', on);
+            b.setAttribute('aria-checked', String(on));
+        });
+        slotRow.replaceChildren();
+        draft.colors.forEach((hex, i) => {
+            const input = el('input', { type: 'color', value: hex, 'aria-label': `Color ${i + 1}` });
+            input.addEventListener('input', () => {
+                draft.colors[i] = input.value;
+                selected = i;
+                input.parentElement.style.background = input.value;
+                preview();
+            });
+            input.addEventListener('change', () => { draft.colors[i] = input.value; changed(); });
+            const slot = el('div', { class: 'stheme-slot' + (i === selected ? ' selected' : '') }, [
+                el('label', { class: 'stheme-swatch', style: `background:${hex}`, title: 'Pick a color', onclick: () => { selected = i; markSelected(); } }, [input])
+            ]);
+            if (draft.colors.length > 1) {
+                slot.append(el('button', {
+                    type: 'button', class: 'stheme-remove', title: 'Remove color', 'aria-label': `Remove color ${i + 1}`,
+                    onclick: () => { draft.colors.splice(i, 1); selected = Math.min(selected, draft.colors.length - 1); changed(); }
+                }, ['×']));
+            }
+            slotRow.append(slot);
+        });
+        if (draft.colors.length < MAX_THEME_COLORS) {
+            slotRow.append(el('button', {
+                type: 'button', class: 'stheme-add', title: 'Add a color (gradient)', 'aria-label': 'Add color',
+                onclick: () => { draft.colors.push(draft.colors[draft.colors.length - 1]); selected = draft.colors.length - 1; changed(); }
+            }, ['+']));
+        }
+        markSelected();
+        intensity.value = Math.round(draft.intensity * 100);
+        grain.value = Math.round(draft.grain * 100);
+    }
+
+    const panel = el('div', { class: 'stheme-editor', role: 'dialog', 'aria-label': `Color for ${space.name}` }, [
+        el('div', { class: 'stheme-header' }, [
+            el('span', { class: 'stheme-title', text: `${space.name} color` }),
+            el('button', { type: 'button', class: 'stheme-close', title: 'Done', 'aria-label': 'Close', onclick: () => close() }, ['×'])
+        ]),
+        modeRow,
+        el('div', { class: 'stheme-label', text: 'Colors' }),
+        slotRow,
+        presetRow,
+        el('label', { class: 'stheme-label' }, ['Intensity', intensity]),
+        el('label', { class: 'stheme-label' }, ['Grain', grain]),
+        el('div', { class: 'stheme-footer' }, [
+            el('button', {
+                type: 'button', class: 'stheme-reset', title: 'Back to the plain named color',
+                onclick: async () => {
+                    clearTimeout(saveTimer);
+                    dirty = false;
+                    await forgetSpaceTheme(space.name);
+                    close(false);
+                    repaintActiveSpace();
+                }
+            }, ['Reset']),
+            el('button', { type: 'button', class: 'stheme-done', onclick: () => close() }, ['Done'])
+        ])
+    ]);
+
+    const onKey = e => { if (e.key === 'Escape') close(); };
+    document.addEventListener('keydown', onKey);
+
+    function close(save = true) {
+        if (openEditor?.panel !== panel) return;
+        document.removeEventListener('keydown', onKey);
+        panel.remove();
+        openEditor = null;
+        if (save) persist().then(() => repaintActiveSpace());
+    }
+
+    document.body.append(panel);
+    openEditor = { close, spaceId: space.id, draft, panel };
+    render();
+    preview();
+    return openEditor;
+}
diff --git a/space-theme-store.js b/space-theme-store.js
new file mode 100644
index 0000000..5c43384
--- /dev/null
+++ b/space-theme-store.js
@@ -0,0 +1,64 @@
+/**
+ * Storage for per-space custom themes.
+ *
+ * Themes live in chrome.storage.sync under one key, mapped by space name, so they follow the
+ * user's Google account like the space bookmark folders do (space IDs differ per computer, names
+ * don't). Writes are serialized so quick successive edits can't overwrite each other.
+ */
+import { normalizeTheme } from './space-theme.js';
+
+export const SPACE_THEMES_KEY = 'spaceThemes';
+
+let writeChain = Promise.resolve();
+function serialize(op) {
+    const run = writeChain.then(op, op);
+    writeChain = run.then(() => { }, () => { });
+    return run;
+}
+
+function cleanMap(map) {
+    const out = {};
+    for (const [name, theme] of Object.entries(map || {})) {
+        const t = normalizeTheme(theme);
+        if (t) out[name] = t;
+    }
+    return out;
+}
+
+export async function loadSpaceThemes() {
+    const result = await chrome.storage.sync.get(SPACE_THEMES_KEY);
+    return cleanMap(result[SPACE_THEMES_KEY]);
+}
+
+/** Save a theme for a space, or remove it with theme = null (back to the named color). */
+export function saveSpaceTheme(spaceName, theme) {
+    return serialize(async () => {
+        const all = await loadSpaceThemes();
+        const t = theme ? normalizeTheme(theme) : null;
+        if (t) all[spaceName] = t;
+        else delete all[spaceName];
+        await chrome.storage.sync.set({ [SPACE_THEMES_KEY]: all });
+        return all;
+    });
+}
+
+/** Keep a space's theme when the space is renamed. */
+export function renameSpaceTheme(oldName, newName) {
+    return serialize(async () => {
+        const all = await loadSpaceThemes();
+        if (oldName === newName || !(oldName in all)) return all;
+        all[newName] = all[oldName];
+        delete all[oldName];
+        await chrome.storage.sync.set({ [SPACE_THEMES_KEY]: all });
+        return all;
+    });
+}
+
+/** Calls back with the full, cleaned map whenever themes change (also from other computers). */
+export function onSpaceThemesChanged(callback) {
+    const listener = (changes, area) => {
+        if (area === 'sync' && changes[SPACE_THEMES_KEY]) callback(cleanMap(changes[SPACE_THEMES_KEY].newValue));
+    };
+    chrome.storage.onChanged.addListener(listener);
+    return () => chrome.storage.onChanged.removeListener(listener);
+}
diff --git a/space-theme.js b/space-theme.js
new file mode 100644
index 0000000..88e34f4
--- /dev/null
+++ b/space-theme.js
@@ -0,0 +1,179 @@
+/**
+ * Per-space custom themes, Arc/Zen style.
+ *
+ * A theme is { colors: ['#rrggbb', ...1-3], mode: 'auto'|'light'|'dark', intensity: 0..1, grain: 0..1 }.
+ *  - colors: one color, or a 2-3 stop gradient
+ *  - mode: 'light' paints on a light base with dark text, 'dark' on a dark base with light text,
+ *          'auto' uses the system appearance as base and picks the text color from the result
+ *  - intensity: how much of the chosen color versus the neutral base (1 = exact color)
+ *  - grain: strength of a noise texture layered over the color
+ *
+ * Everything here is pure (no DOM, no chrome.*) so it can be unit tested.
+ */
+
+export const MAX_THEME_COLORS = 3;
+export const THEME_MODES = ['auto', 'light', 'dark'];
+export const LIGHT_BASE = '#f7f7f8';
+export const DARK_BASE = '#1c1c1f';
+
+// Arcify's named colors (kept for Chrome tab-group sync and the space color field)
+export const NAMED_COLORS = {
+    grey: '#cccccc', blue: '#8bb3f3', red: '#ff9e97', yellow: '#ffe29f',
+    green: '#8bda99', pink: '#fbaad7', purple: '#d6a6ff', cyan: '#a5e2ea'
+};
+
+export const THEME_PRESETS = [
+    '#f4f0e1', '#e9bccb', '#e4c4e4', '#cd7880', '#e08a72', '#d9cc85', '#84e6b2', '#929bbb',
+    '#9ec9f0', '#a5e2ea', '#fbf8e8', '#bdbdbd', '#5b5b66', '#1b1d3a', '#1f3b2c', '#000000'
+];
+
+export const DEFAULT_THEME = Object.freeze({ colors: ['#929bbb'], mode: 'auto', intensity: 0.8, grain: 0 });
+
+const HEX = /^#[0-9a-f]{6}$/i;
+
+function clamp01(value, fallback) {
+    const n = Number(value);
+    if (!Number.isFinite(n)) return fallback;
+    return Math.min(1, Math.max(0, n));
+}
+
+export function normalizeHex(value) {
+    if (typeof value !== 'string') return null;
+    let v = value.trim().toLowerCase();
+    if (/^#[0-9a-f]{3}$/.test(v)) v = '#' + v.slice(1).split('').map(c => c + c).join('');
+    return HEX.test(v) ? v : null;
+}
+
+/** Returns a valid theme, or null if the input can't be a theme at all. */
+export function normalizeTheme(theme) {
+    if (!theme || typeof theme !== 'object') return null;
+    const colors = (Array.isArray(theme.colors) ? theme.colors : [])
+        .map(normalizeHex).filter(Boolean).slice(0, MAX_THEME_COLORS);
+    if (colors.length === 0) return null;
+    return {
+        colors,
+        mode: THEME_MODES.includes(theme.mode) ? theme.mode : DEFAULT_THEME.mode,
+        intensity: clamp01(theme.intensity, DEFAULT_THEME.intensity),
+        grain: clamp01(theme.grain, DEFAULT_THEME.grain)
+    };
+}
+
+export function hexToRgb(hex) {
+    const h = normalizeHex(hex);
+    if (!h) return null;
+    return [1, 3, 5].map(i => parseInt(h.slice(i, i + 2), 16));
+}
+
+export function rgbToHex(rgb) {
+    return '#' + rgb.map(v => Math.round(Math.min(255, Math.max(0, v))).toString(16).padStart(2, '0')).join('');
+}
+
+/** weight = share of `a` in the result (1 => a, 0 => b) */
+export function mixHex(a, b, weight) {
+    const ra = hexToRgb(a), rb = hexToRgb(b);
+    return rgbToHex(ra.map((v, i) => v * weight + rb[i] * (1 - weight)));
+}
+
+/** WCAG relative luminance, 0 (black) .. 1 (white) */
+export function relativeLuminance(hex) {
+    const [r, g, b] = hexToRgb(hex).map(v => {
+        const c = v / 255;
+        return c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
+    });
+    return 0.2126 * r + 0.7152 * g + 0.0722 * b;
+}
+
+function contrast(l1, l2) {
+    const [hi, lo] = l1 > l2 ? [l1, l2] : [l2, l1];
+    return (hi + 0.05) / (lo + 0.05);
+}
+
+const LIGHT_TEXT_LUM = relativeLuminance('#eceff1');
+const DARK_TEXT_LUM = relativeLuminance('#222222');
+
+/**
+ * 'light' text or 'dark' text, whichever reads better across all background colors
+ * (judged on the worst stop, so a gradient never gets text that vanishes at one end).
+ */
+export function pickTextMode(backgrounds) {
+    const lums = backgrounds.map(relativeLuminance);
+    const worst = textLum => Math.min(...lums.map(l => contrast(l, textLum)));
+    return worst(LIGHT_TEXT_LUM) >= worst(DARK_TEXT_LUM) ? 'light' : 'dark';
+}
+
+export function grainDataUri(grain) {
+    const opacity = (0.35 * grain).toFixed(3);
+    const svg = `<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'>` +
+        `<filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/>` +
+        `<feColorMatrix type='saturate' values='0'/></filter>` +
+        `<rect width='100%' height='100%' filter='url(#n)' opacity='${opacity}'/></svg>`;
+    return `url("data:image/svg+xml,${encodeURIComponent(svg)}")`;
+}
+
+/**
+ * Turns a theme into what the sidebar needs to paint.
+ * @param {object} theme
+ * @param {boolean} systemDark - whether the OS/browser is in dark mode (used by 'auto')
+ */
+export function computeThemeStyle(theme, systemDark = false) {
+    const t = normalizeTheme(theme) || DEFAULT_THEME;
+    const base = t.mode === 'light' ? LIGHT_BASE : t.mode === 'dark' ? DARK_BASE : (systemDark ? DARK_BASE : LIGHT_BASE);
+    const painted = t.colors.map(c => mixHex(c, base, t.intensity));
+    const text = t.mode === 'light' ? 'dark' : t.mode === 'dark' ? 'light' : pickTextMode(painted);
+
+    const layers = [];
+    const sizes = [];
+    const repeats = [];
+    if (t.grain > 0) {
+        layers.push(grainDataUri(t.grain));
+        sizes.push('160px 160px');
+        repeats.push('repeat');
+    }
+    layers.push(painted.length === 1
+        ? `linear-gradient(${painted[0]}, ${painted[0]})`
+        : `linear-gradient(165deg, ${painted.join(', ')})`);
+    sizes.push('100% 100%');
+    repeats.push('no-repeat');
+
+    // A single flat color behaves exactly like Arcify's named colors (tabs and folders use it as
+    // their own background). With a gradient or grain they become see-through so the paint shows.
+    const flat = painted.length === 1 && t.grain === 0;
+    const hoverOverlay = text === 'light' ? 'rgba(255, 255, 255, 0.10)' : 'rgba(0, 0, 0, 0.08)';
+    return {
+        painted,
+        text,
+        backgroundColor: painted[0],
+        backgroundImage: layers.join(', '),
+        backgroundSize: sizes.join(', '),
+        backgroundRepeat: repeats.join(', '),
+        spaceBg: flat ? painted[0] : 'transparent',
+        spaceBgDark: flat ? mixHex(painted[0], text === 'light' ? '#ffffff' : '#000000', 0.88) : hoverOverlay
+    };
+}
+
+function hsl(hex) {
+    const [r, g, b] = hexToRgb(hex).map(v => v / 255);
+    const max = Math.max(r, g, b), min = Math.min(r, g, b), d = max - min;
+    const l = (max + min) / 2;
+    if (d === 0) return { h: 0, s: 0, l };
+    const s = d / (1 - Math.abs(2 * l - 1));
+    let h;
+    if (max === r) h = ((g - b) / d) % 6;
+    else if (max === g) h = (b - r) / d + 2;
+    else h = (r - g) / d + 4;
+    return { h: (h * 60 + 360) % 360, s, l };
+}
+
+/** Closest Arcify named color by hue, used for Chrome tab groups and the color field. */
+export function nearestNamedColor(hex) {
+    if (!hexToRgb(hex)) return 'grey';
+    const { h, s } = hsl(hex);
+    if (s < 0.15) return 'grey';
+    if (h < 20 || h >= 345) return 'red';
+    if (h < 70) return 'yellow';
+    if (h < 165) return 'green';
+    if (h < 195) return 'cyan';
+    if (h < 255) return 'blue';
+    if (h < 300) return 'purple';
+    return 'pink';
+}
