+import { describe, it, expect, vi, beforeAll, beforeEach } from 'vitest';
+import { chromeMock } from '../mocks/chrome.js';
+
+vi.mock('../../logger.js', () => ({
+    Logger: { log: vi.fn(), warn: vi.fn(), error: vi.fn(), info: vi.fn(), debug: vi.fn(), initialize: vi.fn() }
+}));
+vi.mock('../../utils.js', () => ({ getSettings: vi.fn().mockResolvedValue({ enableSpotlight: true }) }));
+vi.mock('../../bookmark-utils.js', () => ({ BookmarkUtils: { invalidateBookmarkCache: vi.fn() } }));
+vi.mock('../../shared/data-providers/arcify-provider.js', () => ({ arcifyProvider: { invalidateCache: vi.fn() } }));
+
+const NEWTAB = 'chrome-extension://mock-id/newtab.html';
+let sessionStore = {};
+let onCommand;
+let onMessageListeners;
+
+function installSessionStorage() {
+    chromeMock.storage.session = {
+        get: vi.fn(async key => (key in sessionStore ? { [key]: structuredClone(sessionStore[key]) } : {})),
+        set: vi.fn(async obj => { Object.assign(sessionStore, structuredClone(obj)); })
+    };
+}
+
+beforeAll(async () => {
+    installSessionStorage();
+    await import('../../background.js');
+    onCommand = chromeMock.commands.onCommand.addListener.mock.calls.at(-1)[0];
+    onMessageListeners = chromeMock.runtime.onMessage.addListener.mock.calls.map(c => c[0]);
+});
+
+beforeEach(() => {
+    sessionStore = {};
+    installSessionStorage();
+    chromeMock.tabs.remove = vi.fn().mockResolvedValue(undefined);
+});
+
+const activeTab = tab => chromeMock.tabs.query.mockResolvedValue([tab]);
+
+describe('Arc-style Cmd+T bound to the Spotlight "New Tab" command', () => {
+    it('on a page without content scripts, opens the Spotlight page next to it', async () => {
+        activeTab({ id: 7, index: 3, url: 'chrome://extensions/' });
+        chromeMock.tabs.create.mockResolvedValue({ id: 50 });
+        await onCommand('toggleSpotlightNewTab');
+        expect(chromeMock.tabs.create).toHaveBeenCalledWith(
+            expect.objectContaining({ url: NEWTAB, active: true, index: 4, openerTabId: 7 }));
+        expect(sessionStore.spotlightReturnTabs).toEqual({ 50: 7 });
+    });
+
+    it('a second Cmd+T on the Spotlight page closes it and returns to the previous tab', async () => {
+        sessionStore.spotlightReturnTabs = { 50: 7 };
+        activeTab({ id: 50, index: 4, url: NEWTAB });
+        await onCommand('toggleSpotlightNewTab');
+        expect(chromeMock.tabs.update).toHaveBeenCalledWith(7, { active: true });
+        expect(chromeMock.tabs.remove).toHaveBeenCalledWith(50);
+        expect(chromeMock.tabs.create).not.toHaveBeenCalled();
+        expect(sessionStore.spotlightReturnTabs).toEqual({});
+    });
+
+    it('treats a fresh chrome://newtab tab as the Spotlight page too', async () => {
+        activeTab({ id: 9, index: 1, url: 'chrome://newtab/' });
+        await onCommand('toggleSpotlightNewTab');
+        expect(chromeMock.tabs.remove).toHaveBeenCalledWith(9);
+        expect(chromeMock.tabs.create).not.toHaveBeenCalled();
+    });
+
+    it.each(['edge://newtab/', 'brave://newtab/', 'vivaldi://startpage/', 'opera://startpage/'])(
+        'treats the new-tab page of other Chromium browsers (%s) the same way', async url => {
+            activeTab({ id: 11, index: 1, url });
+            await onCommand('toggleSpotlightNewTab');
+            expect(chromeMock.tabs.remove).toHaveBeenCalledWith(11);
+            expect(chromeMock.tabs.create).not.toHaveBeenCalled();
+        });
+
+    it('on a normal page, asks the overlay to toggle and does not close it first', async () => {
+        // the overlay is open in tab 3 and reported itself
+        const opened = onMessageListeners.map(l => l({ action: 'spotlightOpened' }, { tab: { id: 3 } }, () => {}));
+        activeTab({ id: 3, index: 0, url: 'https://example.com/' });
+        chromeMock.tabs.sendMessage.mockResolvedValue({ success: true });
+        await onCommand('toggleSpotlightNewTab');
+        const actions = chromeMock.tabs.sendMessage.mock.calls.filter(c => c[0] === 3).map(c => c[1].action);
+        expect(actions).toEqual(['activateSpotlight']);
+        expect(chromeMock.tabs.create).not.toHaveBeenCalled();
+    });
+
+    it('if the page cannot take keyboard focus (e.g. a side panel has it), opens the Spotlight page instead', async () => {
+        activeTab({ id: 3, index: 2, url: 'https://example.com/' });
+        chromeMock.tabs.sendMessage.mockResolvedValue({ success: false, error: 'page-not-focused' });
+        chromeMock.tabs.create.mockResolvedValue({ id: 60 });
+        await onCommand('toggleSpotlightNewTab');
+        expect(chromeMock.tabs.create).toHaveBeenCalledWith(
+            expect.objectContaining({ url: NEWTAB, active: true, index: 3, openerTabId: 3 }));
+        expect(sessionStore.spotlightReturnTabs).toEqual({ 60: 3 });
+    });
+
+    it('answers site completion requests from history, top sites and popular sites', async () => {
+        chromeMock.history = { search: vi.fn().mockResolvedValue([
+            { url: 'https://www.youtube.com/watch?v=1', visitCount: 4, typedCount: 1 }
+        ]) };
+        chromeMock.topSites.get.mockResolvedValue([]);
+        const responses = [];
+        const done = new Promise(resolve => {
+            for (const l of onMessageListeners) {
+                const keepOpen = l({ action: 'getSiteCompletion', query: 'you' }, {}, r => { responses.push(r); resolve(); });
+                if (keepOpen === true) break;
+            }
+        });
+        await done;
+        expect(chromeMock.history.search).toHaveBeenCalledWith(expect.objectContaining({ text: 'you' }));
+        expect(responses[0]).toEqual({ success: true, completion: { host: 'youtube.com', url: 'https://www.youtube.com' } });
+    });
+
+    it('Escape on the Spotlight page cancels it', async () => {
+        sessionStore.spotlightReturnTabs = { 50: 7 };
+        const responses = [];
+        for (const l of onMessageListeners) l({ action: 'cancelSpotlightPage' }, { tab: { id: 50, url: NEWTAB } }, r => responses.push(r));
+        await vi.waitFor(() => expect(chromeMock.tabs.remove).toHaveBeenCalledWith(50));
+        expect(chromeMock.tabs.update).toHaveBeenCalledWith(7, { active: true });
+    });
+});
diff --git a/test/unit/recent-tabs-order.test.js b/test/unit/recent-tabs-order.test.js
new file mode 100644
index 0000000..51a9bf4
--- /dev/null
+++ b/test/unit/recent-tabs-order.test.js
@@ -0,0 +1,57 @@
+import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';
+import { chromeMock } from '../mocks/chrome.js';
+
+vi.mock('../../logger.js', () => ({
+    Logger: { log: vi.fn(), warn: vi.fn(), error: vi.fn(), info: vi.fn(), debug: vi.fn(), initialize: vi.fn() }
+}));
+
+import { BackgroundDataProvider } from '../../shared/data-providers/background-data-provider.js';
+
+const EXT = 'chrome-extension://abc/';
+
+describe('empty query lists tabs by most recent use (Arc-style)', () => {
+    let provider;
+    const originalGetURL = chromeMock.runtime.getURL;
+    beforeEach(() => {
+        provider = new BackgroundDataProvider();
+        chromeMock.windows.getLastFocused = vi.fn().mockResolvedValue({ id: 1 });
+        chromeMock.runtime.getURL = vi.fn(path => EXT + path);
+        chromeMock.tabGroups.query.mockResolvedValue([]);
+        chromeMock.tabs.query.mockResolvedValue([
+            { id: 1, title: 'Pinned mail', url: 'https://mail.test', pinned: true, groupId: -1, windowId: 1, lastAccessed: 100 },
+            { id: 2, title: 'Docs', url: 'https://docs.test', groupId: -1, windowId: 1, lastAccessed: 300 },
+            { id: 3, title: 'Current page', url: 'https://current.test', active: true, groupId: -1, windowId: 1, lastAccessed: 999 },
+            { id: 4, title: 'Other window', url: 'https://other.test', active: true, groupId: -1, windowId: 2, lastAccessed: 500 },
+            { id: 5, title: 'Spotlight new tab', url: EXT + 'newtab.html', groupId: -1, windowId: 1, lastAccessed: 800 },
+            { id: 6, title: 'Never focused', url: 'https://never.test', groupId: -1, windowId: 1 },
+            { id: 7, title: 'Edge new tab', url: 'edge://newtab/', groupId: -1, windowId: 1, lastAccessed: 900 }
+        ]);
+    });
+    afterEach(() => {
+        delete chromeMock.windows.getLastFocused;
+        chromeMock.runtime.getURL = originalGetURL;
+    });
+
+    it('orders by lastAccessed, newest first, pinned tabs get no priority', async () => {
+        const ids = (await provider.getOpenTabsData()).map(t => t.id);
+        expect(ids).toEqual([4, 2, 1, 6]);
+    });
+
+    it('leaves out the current tab and the extension own pages', async () => {
+        const ids = (await provider.getOpenTabsData()).map(t => t.id);
+        expect(ids).not.toContain(3);
+        expect(ids).not.toContain(5);
+        expect(ids).not.toContain(7);
+    });
+
+    it('typed queries are unaffected (fuzzy search still finds the current tab)', async () => {
+        const titles = (await provider.getOpenTabsData('current')).map(t => t.title);
+        expect(titles).toContain('Current page');
+    });
+
+    it('keeps every tab if the focused window cannot be determined', async () => {
+        chromeMock.windows.getLastFocused = vi.fn().mockRejectedValue(new Error('no window'));
+        const ids = (await provider.getOpenTabsData()).map(t => t.id);
+        expect(ids).toContain(3);
+    });
+});
diff --git a/test/unit/site-completion.test.js b/test/unit/site-completion.test.js
new file mode 100644
index 0000000..c671495
--- /dev/null
+++ b/test/unit/site-completion.test.js
@@ -0,0 +1,114 @@
+import { describe, it, expect, vi } from 'vitest';
+import { pickSiteCompletion, completeInput, completionTarget, hostOf } from '../../shared/site-completion.js';
+import { InlineCompletion } from '../../shared/inline-completion.js';
+import { SharedSpotlightLogic } from '../../shared/shared-component-logic.js';
+import { SpotlightUtils } from '../../shared/ui-utilities.js';
+
+vi.mock('../../logger.js', () => ({
+    Logger: { log: vi.fn(), warn: vi.fn(), error: vi.fn(), info: vi.fn(), debug: vi.fn(), initialize: vi.fn() }
+}));
+
+describe('pickSiteCompletion', () => {
+    it('prefers the site whose address starts with the query and is visited most', () => {
+        const history = [
+            { url: 'https://www.youtube.com/watch?v=1', title: 'A video - YouTube', visitCount: 3, typedCount: 0 },
+            { url: 'https://www.youtube.com/watch?v=2', title: 'Another - YouTube', visitCount: 2, typedCount: 1 },
+            { url: 'https://you.com/search?q=x', title: 'you.com', visitCount: 1, typedCount: 0 },
+            { url: 'https://example.com/youtube-tips', title: 'YouTube tips', visitCount: 50, typedCount: 5 }
+        ];
+        expect(pickSiteCompletion('you', { history })).toEqual({ host: 'youtube.com', url: 'https://www.youtube.com' });
+    });
+
+    it('uses top sites, then the popular-sites list as a fallback', () => {
+        expect(pickSiteCompletion('gi', { topSites: [{ url: 'https://gitlab.com/' }], popularDomains: ['github.com'] }).host).toBe('gitlab.com');
+        expect(pickSiteCompletion('gi', { popularDomains: ['github.com', 'gizmodo.com'] }).host).toBe('github.com');
+        expect(pickSiteCompletion('gi', { popularDomains: ['github.com'] }).url).toBe('https://github.com');
+    });
+
+    it('offers nothing for searches, paths, exact hosts or unknown prefixes', () => {
+        const opts = { popularDomains: ['youtube.com'] };
+        expect(pickSiteCompletion('you tube', opts)).toBeNull();
+        expect(pickSiteCompletion('youtube.com/feed', opts)).toBeNull();
+        expect(pickSiteCompletion('youtube.com', opts)).toBeNull();
+        expect(pickSiteCompletion('zzz', opts)).toBeNull();
+        expect(pickSiteCompletion('', opts)).toBeNull();
+    });
+
+    it('accepts a typed scheme or www. and completes after it, keeping what was typed', () => {
+        expect(completionTarget('https://www.You')).toEqual({ prefix: 'https://www.', core: 'you' });
+        expect(completeInput('You', 'youtube.com')).toBe('Youtube.com');
+        expect(completeInput('www.you', 'youtube.com')).toBe('www.youtube.com');
+        expect(completeInput('https://you', 'youtube.com')).toBe('https://youtube.com');
+        expect(completeInput('yot', 'youtube.com')).toBeNull();
+        expect(hostOf('https://www.YouTube.com/x')).toBe('youtube.com');
+        expect(hostOf('not a url')).toBeNull();
+    });
+});
+
+function fakeInput(value = '') {
+    return {
+        value,
+        selectionStart: value.length,
+        selectionEnd: value.length,
+        setSelectionRange(start, end) { this.selectionStart = start; this.selectionEnd = end; }
+    };
+}
+
+describe('InlineCompletion', () => {
+    const fetchYouTube = async () => ({ host: 'youtube.com', url: 'https://www.youtube.com' });
+
+    it('completes what was typed and selects the added part', async () => {
+        const input = fakeInput('you');
+        const inline = new InlineCompletion(input, fetchYouTube);
+        const completion = await inline.update({ inputType: 'insertText' });
+        expect(completion.host).toBe('youtube.com');
+        expect(input.value).toBe('youtube.com');
+        expect([input.selectionStart, input.selectionEnd]).toEqual([3, 11]);
+        expect(inline.query).toBe('you');
+    });
+
+    it('does not complete while deleting', async () => {
+        const input = fakeInput('you');
+        const inline = new InlineCompletion(input, fetchYouTube);
+        expect(await inline.update({ inputType: 'deleteContentBackward' })).toBeNull();
+        expect(input.value).toBe('you');
+    });
+
+    it('drops a completion that arrives after the user kept typing', async () => {
+        const input = fakeInput('you');
+        let release;
+        const inline = new InlineCompletion(input, () => new Promise(r => { release = r; }));
+        const pending = inline.update({ inputType: 'insertText' });
+        input.value = 'yout';
+        release({ host: 'youtube.com', url: 'https://www.youtube.com' });
+        expect(await pending).toBeNull();
+        expect(input.value).toBe('yout');
+    });
+
+    it('does not complete when the caret is not at the end', async () => {
+        const input = fakeInput('you');
+        input.selectionStart = input.selectionEnd = 1;
+        const inline = new InlineCompletion(input, fetchYouTube);
+        expect(await inline.update({ inputType: 'insertText' })).toBeNull();
+    });
+});
+
+describe('result rows for a completed site', () => {
+    it('puts the site first and the search for the typed text second, then other results', () => {
+        const rows = SpotlightUtils.generateSiteCompletionSuggestions({ host: 'youtube.com', url: 'https://www.youtube.com' }, 'you');
+        expect(rows.map(r => r.type)).toEqual(['url-suggestion', 'search-query']);
+        expect(rows[0].url).toBe('https://www.youtube.com');
+        const combined = SharedSpotlightLogic.combineResults(rows, [
+            { type: 'history', url: 'https://www.youtube.com/', title: 'YouTube' },
+            { type: 'history', url: 'https://www.youtube.com/watch?v=1', title: 'A video' }
+        ]);
+        expect(combined.map(r => r.url || r.title)).toEqual([
+            'https://www.youtube.com', 'Search for "you"', 'https://www.youtube.com/watch?v=1'
+        ]);
+    });
+
+    it('still accepts a single instant suggestion', () => {
+        const one = SpotlightUtils.generateInstantSuggestion('hello world');
+        expect(SharedSpotlightLogic.combineResults(one, [])).toEqual([one]);
+    });
+});
