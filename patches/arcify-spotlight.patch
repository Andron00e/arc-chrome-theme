--- /dev/null
+++ b/shared/inline-completion.js
@@ -0,0 +1,41 @@
+import { completeInput } from './site-completion.js';
+
+export class InlineCompletion {
+    constructor(input, fetchCompletion) {
+        this.input = input;
+        this.fetchCompletion = fetchCompletion;
+        this.typed = input.value;
+        this.completion = null;
+        this.requestId = 0;
+    }
+
+    get query() {
+        return this.typed;
+    }
+
+    async update(event) {
+        const input = this.input;
+        this.typed = input.value;
+        this.completion = null;
+        const requestId = ++this.requestId;
+
+        const deleting = typeof event?.inputType === 'string' && event.inputType.startsWith('delete');
+        const caretAtEnd = input.selectionStart === input.value.length && input.selectionEnd === input.value.length;
+        if (deleting || !caretAtEnd || !this.typed) return null;
+
+        let completion = null;
+        try {
+            completion = await this.fetchCompletion(this.typed);
+        } catch {
+            completion = null;
+        }
+        if (requestId !== this.requestId || input.value !== this.typed || !completion) return null;
+
+        const text = completeInput(this.typed, completion.host);
+        if (!text) return null;
+        input.value = text;
+        input.setSelectionRange(this.typed.length, text.length);
+        this.completion = completion;
+        return completion;
+    }
+}
