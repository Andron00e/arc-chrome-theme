+// The browser's own new-tab page in Chrome and other Chromium browsers.
+const NEW_TAB_URL = /^(chrome|edge|brave|vivaldi|opera):\/\/(newtab|new-tab-page|startpage)\/?$|^chrome-search:\/\/local-ntp\//;
+
+export function isBrowserNewTabUrl(url) {
+    return typeof url === 'string' && NEW_TAB_URL.test(url);
+}
