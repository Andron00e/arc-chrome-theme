new file mode 100644
index 0000000..500e8f4
--- /dev/null
+++ b/shared/site-completion.js
@@ -0,0 +1,73 @@
+const SCHEME = /^https?:\/\//;
+const DAY_MS = 24 * 60 * 60 * 1000;
+export const HISTORY_WINDOW_MS = 90 * DAY_MS;
+
+export function hostOf(url) {
+    try {
+        return new URL(url).hostname.toLowerCase().replace(/^www\./, '');
+    } catch {
+        return null;
+    }
+}
+
+function originOf(url) {
+    try {
+        const { protocol, origin } = new URL(url);
+        return protocol === 'http:' || protocol === 'https:' ? origin : null;
+    } catch {
+        return null;
+    }
+}
+
+export function completionTarget(query) {
+    if (typeof query !== 'string' || !query || query !== query.trim() || /\s/.test(query)) return null;
+    const lower = query.toLowerCase();
+    const scheme = (lower.match(SCHEME) || [''])[0];
+    let rest = lower.slice(scheme.length);
+    const www = rest.startsWith('www.') ? 'www.' : '';
+    rest = rest.slice(www.length);
+    if (!rest || rest.includes('/') || rest.includes(':')) return null;
+    return { prefix: scheme + www, core: rest };
+}
+
+export function pickSiteCompletion(query, { history = [], topSites = [], popularDomains = [] } = {}) {
+    const target = completionTarget(query);
+    if (!target) return null;
+
+    const candidates = new Map();
+    const add = (host, points, origin = null) => {
+        if (!host || host === target.core || !host.startsWith(target.core)) return;
+        const entry = candidates.get(host) || { host, points: 0, origin: null };
+        entry.points += points;
+        entry.origin = entry.origin || origin;
+        candidates.set(host, entry);
+    };
+
+    for (const item of history) {
+        add(hostOf(item.url), (item.typedCount || 0) * 10 + (item.visitCount || 0), originOf(item.url));
+    }
+    for (const site of topSites) {
+        add(hostOf(site.url), 50, originOf(site.url));
+    }
+    for (const domain of popularDomains) {
+        add(String(domain).toLowerCase().replace(/^www\./, ''), 1);
+    }
+
+    let best = null;
+    for (const entry of candidates.values()) {
+        if (!best
+            || entry.points > best.points
+            || (entry.points === best.points && entry.host.length < best.host.length)
+            || (entry.points === best.points && entry.host.length === best.host.length && entry.host < best.host)) {
+            best = entry;
+        }
+    }
+    if (!best) return null;
+    return { host: best.host, url: best.origin || `https://${best.host}` };
+}
+
+export function completeInput(typed, host) {
+    const target = completionTarget(typed);
+    if (!target || !host || !host.startsWith(target.core) || host === target.core) return null;
+    return typed + host.slice(target.core.length);
+}
